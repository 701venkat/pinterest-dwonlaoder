{
  "manifest_version": 3,
  "name": "Pinterest Board & Image Downloader",
  "description": "Download Pinterest images from screen or full board with readable file names.",
  "version": "1.2.0",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
